# ---------------------------------------------------------------------------
# Lo generado NO se versiona: se versiona lo que lo genera.
#
# El dataset CIERZO son 7,1 GB reproducibles byte a byte desde el generador y su
# semilla. Meterlos aquí haría el repositorio inservible para quien tiene que
# descargarlo, que es exactamente el público al que va dirigido: se publica el
# generador, no los datos.
# ---------------------------------------------------------------------------
datagen/out/
datagen/docker/catalog.sql

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
coverage.xml
# 42,8 MB de contextos de cobertura, regenerables con `make coverage`. Los INFORMES
# de `evals/reports/` sí se versionan —son la evidencia de cada número— pero este es
# la materia prima de la que salen, no el número.
evals/reports/coverage-contexts.json
evals/reports/.duckdb-profile.json
htmlcov/
mutants/

# Punto de retorno que crea `make done` en cada cierre verde
.snapshots/

# Estado que escribe el gate (`scripts/done.py`), no una persona
.gate/

# Sistema
.DS_Store
*.duckdb
*.duckdb.wal

# El almacen de auditoria de una ejecucion local. La cadena es evidencia de UNA
# maquina y de UN momento; versionarla no significaria nada y ademas mezclaria
# datos de consultas reales en el repositorio.
var/

# Material en bruto del video de demostracion. Se publica solo el montaje final en
# H.264 (5 MB, `docs/proof/video/proof.mp4`): los clips sin montar suman 162 MB y el
# original en HEVC no lo reproducen todos los navegadores.
docs/proof/video/[0-9].mp4
docs/proof/video/proof-hevc.mp4
